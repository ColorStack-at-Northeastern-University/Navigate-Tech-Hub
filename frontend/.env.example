# Strapi base URL (must match where your CMS runs). Required for production builds.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: read-only API token when Public role cannot list Resources (Settings → API Tokens → Read-only).
# Server-side only — never prefix with NEXT_PUBLIC_.
# STRAPI_API_TOKEN=

# GitHub suggestion flow — creates Issues in response to /suggest-resource form submissions.
# Fine-grained PAT with Issues:write scope on this repo. Never expose client-side.
# GITHUB_SUGGEST_TOKEN=
# GITHUB_REPO_OWNER=ColorStack-at-Northeastern-University
# GITHUB_REPO_NAME=Navigate-Tech-Hub

# Production ISR cache interval for Strapi-backed pages. Local dev uses no-store.
# STRAPI_REVALIDATE_SECONDS=180

# Suggestion form abuse controls.
# SUGGEST_RATE_LIMIT_MAX=5
# SUGGEST_RATE_LIMIT_WINDOW_SECONDS=3600
