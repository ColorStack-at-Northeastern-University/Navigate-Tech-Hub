{
  "kind": "collectionType",
  "collectionName": "external_resources",
  "info": {
    "singularName": "external-resource",
    "pluralName": "external-resources",
    "displayName": "External Resource",
    "description": "Curated links to third-party tools, platforms, and named programs"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "interview-prep",
        "classes",
        "projects",
        "hackathons",
        "community",
        "programs"
      ],
      "required": true
    },
    "resourceType": {
      "type": "enumeration",
      "enum": [
        "learning-platform",
        "opportunities-board",
        "scholarship-funding",
        "community-network",
        "events-conference",
        "career-tool",
        "documentation-reference"
      ],
      "required": true
    },
    "badge": {
      "type": "string"
    },
    "officialStatus": {
      "type": "enumeration",
      "enum": [
        "official-org",
        "community-vetted"
      ]
    },
    "programType": {
      "type": "enumeration",
      "enum": [
        "early-career-program",
        "fellowship",
        "pre-internship",
        "insight-event",
        "conference"
      ]
    },
    "applicationStatus": {
      "type": "enumeration",
      "enum": [
        "apply-now",
        "closing-soon",
        "rolling",
        "opens-fall-2026",
        "uncertain-2026",
        "closed-this-cycle",
        "year-round"
      ]
    },
    "applicationDeadline": {
      "type": "date"
    },
    "audienceSpecific": {
      "type": "boolean",
      "default": false
    },
    "bostonLocal": {
      "type": "boolean",
      "default": false
    },
    "riskFlag": {
      "type": "enumeration",
      "enum": [
        "dei-rollback-risk",
        "deprecated-soon",
        "verify-before-applying"
      ]
    },
    "lastVerified": {
      "type": "date"
    },
    "relatedArticleSlug": {
      "type": "string"
    }
  }
}
