{
  "kind": "collectionType",
  "collectionName": "external_resources",
  "info": {
    "singularName": "external-resource",
    "pluralName": "external-resources",
    "displayName": "External Resource",
    "description": "Curated links to third-party tools and platforms"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "interview-prep",
        "classes",
        "projects",
        "hackathons",
        "community"
      ],
      "required": true
    },
    "resourceType": {
      "type": "enumeration",
      "enum": [
        "learning-platform",
        "opportunities-board",
        "scholarship-funding",
        "community-network",
        "events-conference",
        "career-tool",
        "documentation-reference"
      ],
      "required": true
    },
    "badge": {
      "type": "string"
    },
    "officialStatus": {
      "type": "enumeration",
      "enum": [
        "official-org",
        "community-vetted"
      ]
    }
  }
}
