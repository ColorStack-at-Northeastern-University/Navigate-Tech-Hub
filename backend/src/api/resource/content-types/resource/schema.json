{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Resource",
    "description": "Internal articles and guides written by students"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "interview-prep",
        "classes",
        "projects",
        "hackathons",
        "community"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "audienceStage": {
      "type": "enumeration",
      "enum": [
        "first-semester",
        "first-year",
        "underclassmen",
        "all-levels"
      ],
      "required": true
    },
    "timeToReadMinutes": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "outcome": {
      "type": "string",
      "required": true
    },
    "contentVolatility": {
      "type": "enumeration",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "required": true
    },
    "tags": {
      "type": "json"
    },
    "difficulty": {
      "type": "enumeration",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "author": {
      "type": "string"
    },
    "lastReviewedAt": {
      "type": "datetime"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
